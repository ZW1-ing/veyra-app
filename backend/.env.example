# 数据库：本地 MySQL；测试环境会被 conftest 覆盖为 SQLite
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/veyra?charset=utf8mb4

# 鉴权与限流
# 留空 = 不校验（仅限本地开发）；部署到服务器必须配置，多个 key 用逗号分隔
API_KEYS=
RATE_LIMIT_PER_MINUTE=120

# 模型后端：mock（离线可跑）/ openai_compat（DeepSeek、Ollama、任意兼容服务）
LLM_PROVIDER=mock
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5
# 可选：模型价格，单位美元 / 百万 token；未配置的模型费用按 0 记录
# MODEL_PRICES={"qwen2.5":{"prompt_per_million":0.2,"completion_per_million":0.6}}

# 嵌入向量：
#   hash          —— 离线、确定性，零成本，但没有语义能力（只适合跑测试）
#   openai_compat —— 真实语义向量，本地可用 Ollama 的 bge-m3（推荐）
# 实测差距（scripts/evaluate_retrieval.py）：hash 召回 87.5%、MRR 0.750；
# bge-m3 召回 100%、MRR 1.000。要用真语义就把下面两行换成 openai_compat + bge-m3。
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=256
# EMBEDDING_PROVIDER=openai_compat
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024

# 检索与 Agent 行为
RETRIEVAL_TOP_K=6
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120
HISTORY_MAX_TOKENS=3000
# 阈值由实测校准，改前先跑 scripts/evaluate_retrieval.py --sweep 看影响
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_MIN_COVERAGE=0.25
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.55

# 多智能体
SWARM_MAX_MEMBERS=5
SWARM_MAX_CONCURRENCY=2
SWARM_TASK_TIMEOUT_SECONDS=120

# 开发期自动建表（生产设为 false，改用 alembic upgrade head）
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO
